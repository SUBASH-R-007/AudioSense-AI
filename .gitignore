# Python
__pycache__/
*.pyc
backend/.venv/
.pytest_cache/

# ML artifacts ARE committed (~8 MB total).
#
# Training peaks near 500 MB of memory, which is at the ceiling of most free
# hosting tiers, so building them on deploy fails unpredictably. Shipping them
# makes every platform viable, keeps deploys fast, and guarantees the deployed
# model is byte-identical to the tested one.
# Regenerate with: python -m app.ml.generate_dataset && python -m app.ml.train

# Runtime state — API keys, patient records and issued handouts
backend/data/ai_config.json
backend/data/verify_store.json
backend/data/records.db
backend/data/handouts.json
backend/data/feedback.jsonl

# Node
frontend/node_modules/
frontend/dist/

# Misc
.DS_Store
*.log
