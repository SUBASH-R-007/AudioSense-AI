.venv/
__pycache__/
*.pyc
.pytest_cache/
tests/

# Local credentials. The build context is backend/ and the Dockerfile does
# COPY . ., so a developer's .env would be baked into the image — and app
# main.py reads it at startup on any host that does not set those variables
# itself. That would hand every deployment built from this tree the same
# account hash and the same token-signing key, defeating the fail-closed
# default in app/services/auth.py.
.env
.env.*

# Runtime state — never bake a developer's local records into the image.
data/records.db
data/handouts.json
data/feedback.jsonl
data/ai_config.json
data/verify_store.json

# A local copy of the public otoscope dataset can be gigabytes. The trained
# model artifact is already committed, so the image never needs the raw data.
data/otoscope_kaggle/
data/_kaggle_tmp/
