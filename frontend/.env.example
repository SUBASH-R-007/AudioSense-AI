# Frontend environment
#
# LOCAL DEVELOPMENT: leave this file alone and do not create a .env.
# With VITE_API_BASE_URL unset, every request stays relative (/api/...) and
# the Vite dev proxy forwards it to the backend on :8000.
#
# PRODUCTION (Vercel): set VITE_API_BASE_URL in the Vercel dashboard to the
# public Railway URL of the backend, with no trailing slash. It is read at
# BUILD time, so changing it requires a redeploy, not just a restart.

VITE_API_BASE_URL=https://your-backend.up.railway.app
